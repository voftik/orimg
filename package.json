{
  "name": "orimg",
  "version": "0.1.0",
  "description": "Fan-out image generation CLI for OpenRouter: model-specific prompts to multiple top image models, file-first output with manifest and HTML gallery",
  "type": "module",
  "license": "MIT",
  "bin": {
    "orimg": "dist/cli.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "skill"
  ],
  "keywords": [
    "openrouter",
    "image-generation",
    "cli",
    "fanout",
    "agent-skill"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "smoke": "SMOKE=1 node test/smoke.real.mjs",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
