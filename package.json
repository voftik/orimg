{
  "name": "orimg",
  "version": "0.3.0",
  "description": "One task in, four frontier image models out. Multi-model image generation fan-out via OpenRouter — zero-dep CLI + auto-activating agent skill for Claude Code & Codex.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "orimg": "dist/cli.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "skill"
  ],
  "keywords": [
    "image-generation",
    "openrouter",
    "claude-code",
    "codex",
    "agent-skills",
    "ai",
    "cli",
    "seedream",
    "gemini",
    "nano-banana",
    "gpt-image",
    "grok",
    "fan-out"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "SMOKE=1 node test/smoke.real.mjs",
    "install-skill": "node scripts/install-skill.mjs",
    "prepublishOnly": "npm run build && node --test test/unit.files.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voftik/orimg.git"
  },
  "homepage": "https://github.com/voftik/orimg#readme",
  "bugs": {
    "url": "https://github.com/voftik/orimg/issues"
  },
  "author": "voftik"
}
